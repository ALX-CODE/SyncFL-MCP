# Fails if any of FILES contains one of NEEDLES as ASCII or UTF-16LE text, in
# either slash style. Guards against shipping the builder's directories or name.
string(REPLACE "|" ";" files "${FILES}")
string(REPLACE "|" ";" needles "${NEEDLES}")
set(variants)
foreach(needle IN LISTS needles)
  if(needle STREQUAL "")
    continue()
  endif()
  string(REPLACE "/" "\\" backslashed "${needle}")
  string(REPLACE "\\" "/" forward "${needle}")
  foreach(form IN ITEMS "${needle}" "${backslashed}" "${forward}")
    string(TOLOWER "${form}" lower)
    string(TOUPPER "${form}" upper)
    list(APPEND variants "${form}" "${lower}" "${upper}")
  endforeach()
endforeach()
list(REMOVE_DUPLICATES variants)
foreach(file IN LISTS files)
  file(READ "${file}" content HEX)
  string(TOLOWER "${content}" content)
  foreach(text IN LISTS variants)
    string(HEX "${text}" ascii)
    string(TOLOWER "${ascii}" ascii)
    string(REGEX REPLACE "(..)" "\\100" utf16 "${ascii}")
    foreach(pattern IN ITEMS "${ascii}" "${utf16}")
      string(FIND "${content}" "${pattern}" position)
      # Hex offsets must be byte-aligned to count as a real match.
      while(NOT position EQUAL -1)
        math(EXPR odd "${position} % 2")
        if(odd EQUAL 0)
          message(FATAL_ERROR "${file} embeds '${text}'")
        endif()
        math(EXPR next "${position} + 1")
        string(SUBSTRING "${content}" ${next} -1 rest)
        string(FIND "${rest}" "${pattern}" relative)
        if(relative EQUAL -1)
          set(position -1)
        else()
          math(EXPR position "${next} + ${relative}")
        endif()
      endwhile()
    endforeach()
  endforeach()
  message(STATUS "${file}: no build paths or user name embedded")
endforeach()
